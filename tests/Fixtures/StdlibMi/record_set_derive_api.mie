module Tests/StdlibMi/RecordSetDeriveApi

import IO/Console

# A record whose member variables all hash and compare is a Set element, also when a routine signature names the Set
# and when a member variable is a tuple of such parts.

record Plain
    x: Int

record Slot
    tag: Int
    name: Text

record Outer
    pair: (Slot, Int)
    label: Text

routine plain_count(s: Set[Plain]) -> Int
    return s.count()

routine outer_count(s: Set[Outer]) -> Int
    return s.count()

routine start()
    var plains = Set[Plain]()
    plains.add(Plain(x: 1))
    plains.add(Plain(x: 1))
    plains.add(Plain(x: 2))
    show(f"plain: {plain_count(s: plains)}")

    var outers = Set[Outer]()
    outers.add(Outer(pair: (Slot(tag: 1, name: "a"), 2), label: "x"))
    outers.add(Outer(pair: (Slot(tag: 1, name: "a"), 2), label: "x"))
    outers.add(Outer(pair: (Slot(tag: 1, name: "b"), 2), label: "x"))
    show(f"outer: {outer_count(s: outers)}")
    show(f"has: {outers.has(Outer(pair: (Slot(tag: 1, name: "b"), 2), label: "x"))}")
    show(f"equal: {Outer(pair: (Slot(tag: 1, name: "a"), 2), label: "x") == Outer(pair: (Slot(tag: 1, name: "a"), 3), label: "x")}")
    return
