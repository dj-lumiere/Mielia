module Tests/StdlibMi/EntityOptionalForce

import IO/Console

# `x!!` on an optional entity (`E?`) gives the entity, or crashes when there is none, as it does on any other `T?`.
entity Node
    n: Int
    up: Node?

routine depth(start: Node) -> Int
    var count = 0
    var cur: Node? = start.up
    until cur is None
        count = count + 1
        cur = cur!!.up
    return count

routine start()
    var a = Node(n: 1, up: none)
    var b = Node(n: 2, up: a)
    var c = Node(n: 3, up: b)
    show(f"parent of c: {c.up!!.n}")
    show(f"grandparent of c: {c.up!!.up!!.n}")
    var kept: Node? = c.up
    show(f"kept: {kept!!.n}")
    show(f"depth of c: {depth(start: c)}")
    show("DONE")
    return
