module Tests/StdlibMi/FileReadWriteMi

# A FileSink writes text, values and raw bytes with `write`, and a FileSource reads them back with the read family,
# `EndOfInputError` once the file has ended. The output path uses the gitignored `.out` extension.

routine start()
    var file = FileManager.make_file(at: File(at: "tests/Fixtures/StdlibMi/file_read_write_sf.out"), replacing: true)
    var total: D128 = 2.5
    using FileManager.open_write(at: file) as f
        f.write("first line")
        f.write(total)
        f.write(42, end: " ")
        f.write("words")
        f.write("tail".encode_as_utf8())
    using FileManager.open_read(at: file) as r
        show(r.read_line())
        var d: D128 = r.read()
        show(d)
        show(r.read_word())
        show(r.read_line())
        show(r.read_lines())
        show(try r.read_line())
