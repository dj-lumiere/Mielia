module Tests/StdlibMi/WorksCalleeStoreRecordApi

# A routine stores a new record holding an entity into an entity a job already shares, and the job reads the stored
# entity through it. Three things hold: the job reads the holder's member variable under the holder's lock, a statement
# that waits for the job does not hold the holder's lock while it waits, and the stored value, which the holder keeps
# from now on, is not torn down again when the storing routine is a `try` or `check` variant.

import IO/Console

entity Box
    n: S64

record Slot
    box: Box
    tag: S64

entity SlotHolder
    ready: Bool
    done: Bool
    slot: Slot

routine watch(holder: SlotHolder) -> S64
    until holder.ready
        waitfor(1ms)
    return holder.slot.box.n

routine watch_last(holder: SlotHolder) -> S64
    until holder.done
        waitfor(1ms)
    return holder.slot.box.n

routine put(holder: SlotHolder, n: S64) -> S64
    var made = Slot(box: Box(n: n), tag: 1)
    holder.slot = made
    holder.ready = true
    return n

routine put_twice(holder: SlotHolder) -> S64
    if holder.ready
        throw AbsentValueError()
    holder.slot = Slot(box: Box(n: 41), tag: 2)
    var again = Slot(box: Box(n: 42), tag: 3)
    holder.slot = again
    holder.done = true
    return 0

routine start()
    var first = SlotHolder(ready: false, done: false, slot: Slot(box: Box(n: 0), tag: 0))
    var job = watch.to[Work](holder: first)
    job.start_now()
    var r = put(holder: first, n: 7)
    show(f"{r}")
    show(f"seen {job.retrieve()} now {first.slot.box.n}")

    var second = SlotHolder(ready: false, done: false, slot: Slot(box: Box(n: 0), tag: 0))
    var last = watch_last.to[Work](holder: second)
    last.start_now()
    var r2 = try put_twice(holder: second)
    show(f"{r2}")
    show(f"seen {last.retrieve()} now {second.slot.box.n}")
    var again = try put_twice(holder: second)
    show(f"{again}")
    return
