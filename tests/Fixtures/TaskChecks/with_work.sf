module Tests/TaskChecks/WithWork

import IO/Console

entity Counter
    n: S64

routine bump(counter: Counter, times: S64) -> S64
    for i in 0 til times
        counter.n += 1
    return times

routine start()
    var counter = Counter(n: 0)
    var job = bump.to[Work](counter: counter, times: 10)
    job.start_now()
    job.retrieve()
    show(f"{counter.n}")
    return
