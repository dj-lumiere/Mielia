module Tests/TaskChecks/ConfinedLocal

import IO/Console

entity Counter
    n: S64

routine bump(counter: Counter, times: S64) -> S64
    for i in 0 til times
        counter.n += 1
    return times

routine first_of(values: List[Int]) -> Int
    return values[0]

routine start()
    var counter = Counter(n: 0)
    var job = bump.to[Work](counter: counter, times: 10)
    job.start_now()
    # `steps` is only ever the receiver of the list's own routines: no other task can reach it.
    var steps = [1, 2, 3]
    var total = 0
    until steps.is_empty()
        total += steps.remove_last()
    # `handed` is given to a routine and `walked` gives out an emitter over itself: both keep their lock.
    var handed = [7, 8]
    total += first_of(values: handed)
    var walked = [9]
    var walk = walked.emitter()
    total += walk.emit()
    job.retrieve()
    show(f"{counter.n} {total}")
    return
