module Tests/StdlibSf/OptionalEntityNoneApi

# An optional entity is a slot that may hold none, so `none` goes into a list or a dict of them. The type argument
# is written `Optional[Box]` or `Box?`.
entity Box
    n: Int

routine start()
    var xs = List[Optional[Box]]()
    xs.add_last(value: none)
    xs.add_last(value: Box(n: 4))
    var ys = List[Box?]()
    ys.add_last(value: none)
    var d = Dict[Int, Optional[Box]]()
    d[1] = none
    show(f"{xs.count()} {ys.count()} {d.count()}")
    show("DONE")
    return
