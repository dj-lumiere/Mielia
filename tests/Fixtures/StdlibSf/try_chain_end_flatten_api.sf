module Tests/StdlibSf/TryChainEndFlattenApi

# A `try` chain that ends in a `T?` of a record gives one `T?`, not a `T??`: a none end is the one absence, and a
# failure on the way is the same absence.

crashable StopError
    reason: Text

routine StopError.crash_message() -> Text
    return me.reason

routine pass[T](x: T, stop: Bool) -> T
    if stop
        throw StopError(reason: "stop")
    return x

routine start()
    var present: Int? = 7
    var absent: Int? = none
    var count_a: Int? = try pass(x: present, stop: false)
    var count_b: Int? = try pass(x: absent, stop: false)
    var count_c: Int? = try pass(x: present, stop: true)
    show(f"record: {count_a} {count_b} {count_c}")
    return
