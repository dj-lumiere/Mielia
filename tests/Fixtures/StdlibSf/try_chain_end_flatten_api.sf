module Tests/StdlibSf/TryChainEndFlattenApi

# A `try` chain that ends in a `T?` gives one `T?`, not a `T??`: a none end is the one absence, and a failure on the
# way is the same absence.

entity Node
    n: Int

crashable StopError
    reason: Text

routine StopError.crash_message() -> Text
    return me.reason

routine pass[T](x: T, stop: Bool) -> T
    if stop
        throw StopError(reason: "stop")
    return x

routine show_node(label: Text, node: Node?)
    when node
        is Node as held => show(f"{label}: node {held.n}")
        is None => show(f"{label}: none")
    return

routine start()
    var present: Int? = 7
    var absent: Int? = none
    var count_a: Int? = try pass(x: present, stop: false)
    var count_b: Int? = try pass(x: absent, stop: false)
    var count_c: Int? = try pass(x: present, stop: true)
    show(f"record: {count_a} {count_b} {count_c}")

    var held: Node? = Node(n: 3)
    var node_a: Node? = try pass(x: held, stop: false)
    show_node(label: "entity a", node: node_a)
    var missing: Node? = none
    var node_b: Node? = try pass(x: missing, stop: false)
    show_node(label: "entity b", node: node_b)
    var stopped: Node? = Node(n: 4)
    var node_c: Node? = try pass(x: stopped, stop: true)
    show_node(label: "entity c", node: node_c)
    return
