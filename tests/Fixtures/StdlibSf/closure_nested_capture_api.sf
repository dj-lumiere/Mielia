module Tests/StdlibSf/ClosureNestedCaptureApi

# A lambda inside a lambda: the inner one captures the outer one's parameter, the outer one captures a local.
import EmitterTools

routine offset_row(dy: Int) -> List[(Int, Int)]
    return (-1 to 1).select(transform: dx given dy => (dx, dy)).to[List]()

routine start()
    var width: Int = 3
    var grid = (0 til 2).select_many(transform: y given width => (0 til width).select(transform: x given y => (x, y)).to[List]())
        .to[List]()
    show(f"{grid}")

    var around = (-1 to 1).select_many(transform: dy => offset_row(dy)).to[List]()
    show(f"{around}")
    return
