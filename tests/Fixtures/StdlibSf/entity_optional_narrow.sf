module Tests/StdlibSf/EntityOptionalNarrow

import IO/Console

# An optional entity (`E?`) is the entity after a check: `if x is None` with a block that returns, `isnot None`, a
# `when` whose `is None` arm returns, and a loop that reads the checked name while giving it a new value.
entity Box
    n: Int

entity Node
    n: Int
    next: Node?

routine size(b: Box?) -> Int
    when b
        is None => return 0
    return b.n

routine describe(b: Box?) -> Text
    if b is None
        return "nothing"
    return f"box {b.n}"

routine total(head: Node) -> Int
    var sum = head.n
    var cur = head.next
    until cur is None
        sum = sum + cur.n
        cur = cur.next
    return sum

routine start()
    show(f"size {size(b: Box(n: 3))} {size(b: none)}")
    show(describe(b: none))
    show(describe(b: Box(n: 5)))
    var a = Node(n: 1, next: none)
    var b = Node(n: 2, next: a)
    var c = Node(n: 3, next: b)
    show(f"total {total(head: c)}")
    a.next = Node(n: 10, next: none)
    show(f"total {total(head: c)}")
    var xs = List[Box?]()
    xs.add_last(value: none)
    xs.add_last(value: Box(n: 7))
    for x in xs
        show(describe(b: x))
    var maybe: Box? = none
    show(f"{maybe}")
    maybe = Box(n: 9)
    if maybe isnot None
        maybe.n = 10
    show(f"{maybe} {maybe ?? Box(n: 0)}")
    when maybe
        is None => show("none")
        else as got => show(f"got {got.n}")
    show("DONE")
    return
