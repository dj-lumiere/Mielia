module Tests/StdlibSf/WorksLateStoreSortedApi

import Collections
# An entity put into a sorted dictionary, a priority queue or a rotatable list after a job started is shared with the
# job too: both sides keep every update.

import IO/Console

entity Box
    n: S64

routine bump_sorted(boxes: SortedDict[S64, Box], rounds: S64) -> S64
    until boxes.count() > 0
        waitfor(1ms)
    var box = boxes[7]
    for i in 0 til rounds
        box.n += 1
    return rounds

routine bump_queue(boxes: PriorityQueue[S64, Box], rounds: S64) -> S64
    until boxes.count() > 0
        waitfor(1ms)
    var box = boxes.peek()
    for i in 0 til rounds
        box.n += 1
    return rounds

routine bump_ring(boxes: RotatableList[Box], rounds: S64) -> S64
    until boxes.count() > 0
        waitfor(1ms)
    var box = boxes[0]
    for i in 0 til rounds
        box.n += 1
    return rounds

routine start()
    var rounds: S64 = 300000

    var sorted = SortedDict[S64, Box]()
    var in_sorted = bump_sorted.to[Work](boxes: sorted, rounds: rounds)
    in_sorted.start_now()
    var first = Box(n: 0)
    sorted[7] = first
    for i in 0 til rounds
        first.n += 1
    in_sorted.retrieve()
    show(f"sorted dict {first.n}")

    var queue = PriorityQueue[S64, Box]()
    var in_queue = bump_queue.to[Work](boxes: queue, rounds: rounds)
    in_queue.start_now()
    var second = Box(n: 0)
    queue.add(element: second, priority: 1)
    for i in 0 til rounds
        second.n += 1
    in_queue.retrieve()
    show(f"priority queue {second.n}")

    var ring = RotatableList[Box]()
    var in_ring = bump_ring.to[Work](boxes: ring, rounds: rounds)
    in_ring.start_now()
    var third = Box(n: 0)
    ring.add_last(third)
    for i in 0 til rounds
        third.n += 1
    in_ring.retrieve()
    show(f"rotatable list {third.n}")
    show("DONE")
    return
