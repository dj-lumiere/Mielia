module Tests/StdlibSf/WorksWaitInStatementApi

# A statement that waits for another job and also reads a shared entity does not hold the entity's access lock while
# it waits: the job needs that entity to finish. Waits for a job held in a list, for every job of a list, for a
# mailbox value and for a channel value, each in the same text as a read of the entity.

import IO/Console

entity Holder
    x: S64

routine touch(holder: Holder) -> S64
    holder.x += 1
    return holder.x

routine feed(holder: Holder, m: Mailbox[S64]) -> S64
    holder.x += 1
    m.add_last(value: holder.x)
    return 0

routine send(holder: Holder, tx: Transmitter[S64]) -> S64
    holder.x += 1
    tx.transmit(item: holder.x)
    tx.close()
    return 0

routine start()
    var one = Holder(x: 0)
    var jobs = [touch.to[Work](holder: one)]
    jobs[0].start_now()
    show(f"list {jobs[0].retrieve()} holder {one.x}")

    var two = Holder(x: 0)
    var all = [touch.to[Work](holder: two), touch.to[Work](holder: two)]
    all.start_now()
    show(f"gather {all.gather().count()} holder {two.x}")

    var three = Holder(x: 0)
    var m = Mailbox[S64](capacity: 1)
    var feeder = feed.to[Work](holder: three, m: m)
    feeder.start_now()
    show(f"mailbox {m.remove_first()} holder {three.x}")
    feeder.retrieve()

    var four = Holder(x: 0)
    var (tx, rx) = make_shared_channel[S64](capacity: 1)
    var sender = send.to[Work](holder: four, tx: tx)
    sender.start_now()
    var drain = rx.emitter()
    show(f"channel {drain.emit()} holder {four.x}")
    sender.retrieve()
    return
