module Tests/StdlibSf/RecordHoldingEntityApi

# A record whose only managed field is an entity is torn down with the record it lives in: made in a routine, passed
# on, nested in another record and left as a temporary.
entity Node
    n: Int

record Wrap
    node: Node

record Outer
    inner: Wrap
    k: Int

routine mk(i: Int) -> Wrap
    return Wrap(node: Node(n: i))

routine take(w: Wrap) -> Int
    return w.node.n

routine start()
    var total: Int = 0
    for i in 0 til 5
        total += mk(i: i).node.n
        total += take(w: mk(i: i))
        var o = Outer(inner: mk(i: i), k: 1)
        total += o.inner.node.n + o.k
    show(f"total {total}")
    show("DONE")
    return
