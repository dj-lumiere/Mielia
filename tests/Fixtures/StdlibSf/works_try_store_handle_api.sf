module Tests/StdlibSf/WorksTryStoreHandleApi

# A routine stores an entity that holds another entity into a member variable of an entity a job already shares, and
# the routine is called under `try`. The entity the member variable keeps is one more holder of the entity, so the
# `try` variant of the routine must not give that holder back, and the job reads the stored entity through the holder.

import IO/Console

entity Box
    n: S64

entity Wrap
    box: Box
    tag: S64

entity Holder
    slot: Wrap
    ready: Bool

routine store(shared: Holder, v: Wrap, fail: Bool) -> S64
    if fail
        throw VerificationFailedError()
    shared.slot = v
    shared.ready = true
    return 0

routine reader(shared: Holder) -> S64
    until shared.ready
        waitfor(1ms)
    return shared.slot.tag

routine start()
    var shared = Holder(slot: Wrap(box: Box(n: -1), tag: 0), ready: false)
    var job = reader.to[Work](shared: shared)
    job.start_now()
    var v = Wrap(box: Box(n: 0), tag: 7)
    var box = v.box
    var stored = try store(shared: shared, v: v, fail: false)
    box.n += 1
    show(f"stored {stored} tag {job.retrieve()} count {shared.slot.box.n}")
    var failed = try store(shared: shared, v: v, fail: true)
    show(f"failed {failed} count {shared.slot.box.n}")
    return
