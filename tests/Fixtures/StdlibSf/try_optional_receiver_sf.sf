module Tests/StdlibSf/TryOptionalReceiverSf

import IO/Console

# try and check reach through an E? or a record? receiver: none is an AbsentValueError the same keyword receives,
# otherwise the call runs on the value, and a call below it that fails is received the same way.
entity Box
    n: Int

routine Box.doubled() -> Int
    return me.n * 2

routine Box.fail() -> Int
    throw DivisionByZeroError()

routine Box.deep() -> Int
    return me.doubled() + me.fail()

record Pt
    x: Int

routine Pt.twice() -> Int
    return me.x * 2

routine start()
    var some: Box? = Box(n: 21)
    var empty_box: Box? = none
    show(f"try on a value: {try some.doubled()}")
    show(f"try on none: {try empty_box.doubled()}")
    show(f"try below the receiver: {try some.deep()}")
    when check empty_box.doubled()
        is Int as v => show(f"check on none gave {v}")
        else as e => show(f"check on none: {e.crash_message()}")
    when check some.doubled()
        is Int as v => show(f"check on a value: {v}")
        else as e => show(f"check on a value failed: {e.crash_message()}")
    var pt: Pt? = Pt(x: 4)
    var no_pt: Pt? = none
    show(f"record: {try pt.twice()}, {try no_pt.twice()}")
    var optionals = List[Int?]()
    optionals.add_last(value: 5)
    optionals.add_last(value: none)
    var ends_in_value: Int? = try optionals.first()
    var ends_in_none: Int? = try optionals.last()
    show(f"a chain ending in a T? gives one T?: {ends_in_value}, {ends_in_none}")
    show("DONE")
    return
