{
  "name": "mielia",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "lumifoundry",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "mielia",
        "aliases": [
          "Mielia",
          "mielia"
        ],
        "extensions": [
          ".mie"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/mielia.svg",
          "dark": "./icons/mielia.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "mielia",
        "scopeName": "source.mie",
        "path": "./syntaxes/Mielia.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "type",
        "superType": "type",
        "description": "%token.type%"
      },
      {
        "id": "recordType",
        "superType": "struct",
        "description": "%token.recordType%"
      },
      {
        "id": "entityType",
        "superType": "class",
        "description": "%token.entityType%"
      },
      {
        "id": "constant",
        "superType": "variable",
        "description": "%token.constant%"
      },
      {
        "id": "docTag",
        "superType": "keyword",
        "description": "%token.docTag%"
      },
      {
        "id": "docValue",
        "superType": "variable",
        "description": "%token.docValue%"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "mielia",
        "scopes": {
          "type": [
            "entity.name.type"
          ],
          "recordType": [
            "entity.name.type.struct",
            "entity.name.type"
          ],
          "entityType": [
            "entity.name.type.class",
            "entity.name.type"
          ],
          "constant": [
            "variable.other.constant"
          ],
          "docTag": [
            "storage.type.class.jsdoc"
          ],
          "docValue": [
            "variable.other.jsdoc"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[mielia]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "decorator:mielia": "#E5C07B",
          "interface:mielia": {
            "foreground": "#8CCBFF",
            "fontStyle": "italic"
          },
          "recordType:mielia": "#E8954A",
          "entityType:mielia": "#5CB2FF"
        }
      }
    },
    "configuration": {
      "title": "Mielia",
      "properties": {
        "mielia.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%setting.path%"
        }
      }
    },
    "commands": [
      {
        "command": "mielia.restartServer",
        "title": "%command.restart%",
        "category": "Mielia"
      },
      {
        "command": "mielia.runFile",
        "title": "%command.runFile%",
        "category": "Mielia",
        "icon": "$(play)"
      },
      {
        "command": "mielia.runFolder",
        "title": "%command.runFolder%",
        "category": "Mielia",
        "icon": "$(run-all)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mielia.runFile",
          "when": "resourceLangId == mielia",
          "group": "z_commands@1"
        },
        {
          "command": "mielia.runFolder",
          "when": "resourceLangId == mielia",
          "group": "z_commands@2"
        }
      ],
      "explorer/context": [
        {
          "command": "mielia.runFile",
          "when": "resourceLangId == mielia",
          "group": "z_commands@1"
        }
      ],
      "editor/title": [
        {
          "command": "mielia.runFile",
          "when": "resourceLangId == mielia",
          "group": "navigation@1"
        },
        {
          "command": "mielia.runFolder",
          "when": "resourceLangId == mielia",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mielia.runFile",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == mielia"
      },
      {
        "command": "mielia.runFolder",
        "key": "ctrl+shift+f5",
        "mac": "cmd+shift+f5",
        "when": "editorLangId == mielia"
      }
    ]
  },
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "compile": "npm run assets && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license -o dist/mielia.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
