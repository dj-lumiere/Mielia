module System

# Each declaration below creates nothing: `@rv` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the protocol for non-mutating subtraction.
### Types that obey `Subtractable` define a difference operation that returns a
### new value while preserving both inputs.
@rv("Subtractable")
protocol Subtractable
    ### Returns the difference between this value and the other value.
    ### The exact interpretation of subtraction depends on the conforming type's
    ### algebraic domain.
    ### :param you: The value to subtract.
    ### :returns: The resulting `Me` value.
    routine Me.sub(you: Me) -> Me
