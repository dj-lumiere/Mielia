module System

# Each declaration below creates nothing: `@rv` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the crashable raised when a byte is not a valid ASCII hexadecimal digit.
@rv("InvalidHexDigitError")
crashable InvalidHexDigitError
    nothing

### Returns the default message for invalid ASCII hexadecimal digit failures.
### :returns: The resulting `Text` value.
@rv("InvalidHexDigitError.crash_message")
routine InvalidHexDigitError.crash_message() -> Text
