module System

# Each declaration below creates nothing: `@rv` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### The type with exactly one value, `none`. A routine with nothing to return returns `None`, and it is the branch
### of `T?` that holds nothing, matched with `is None`.
@rv("None")
record None
obeys Copyable
    nothing

### Returns the display form of `None`.
### :returns: The resulting `Text` value.
@rv("None.represent")
routine None.represent() -> Text

### Returns the diagnostic form of `None`.
### For this type, the display and diagnostic forms are identical.
### :returns: The resulting `Text` value.
@rv("None.diagnose")
routine None.diagnose() -> Text
