module System

# Each declaration below creates nothing: `@rv` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the crashable raised when indexed access uses a position outside
### the valid range of a collection or view.
@rv("IndexOutOfBoundsError")
crashable IndexOutOfBoundsError
    ### Stores the index that was requested.
    index: U64
    ### Stores the total number of addressable elements.
    count: U64

### Represents the crashable raised when an operation requires at least one
### element but the collection is empty.
@rv("EmptyCollectionError")
crashable EmptyCollectionError
    ### Stores the operation name or summary that could not be completed.
    operation: Text

### Represents the crashable raised when a value is added to a collection whose fixed capacity is all in use (a
### `PartialItems` holding `capacity` elements).
@rv("FullCollectionError")
crashable FullCollectionError
    ### Stores how many elements the collection holds at most.
    capacity: U64

### Represents the crashable raised when a search operation cannot find any
### matching element.
@rv("ElementNotFoundError")
crashable ElementNotFoundError
    nothing

### Represents the crashable raised when values are collected into a collection of a fixed size (an `Items[T, N]`)
### and there are fewer or more of them than it holds.
@rv("ElementCountMismatchError")
crashable ElementCountMismatchError
    ### Stores how many elements the collection holds.
    expected: U64
    ### Stores how many values there were, or `expected` + 1 when there were more than `expected` (the rest is not read).
    found: U64

### Returns the default message for a fixed-size collection filled with the wrong number of values.
### :returns: The resulting `Text` value.
@rv("ElementCountMismatchError.crash_message")
routine ElementCountMismatchError.crash_message() -> Text

### Returns the default message for failed indexed access.
### :returns: The resulting `Text` value.
@rv("IndexOutOfBoundsError.crash_message")
routine IndexOutOfBoundsError.crash_message() -> Text

### Returns the default message for invalid empty-collection operations.
### :returns: The resulting `Text` value.
@rv("EmptyCollectionError.crash_message")
routine EmptyCollectionError.crash_message() -> Text

### Returns the default message for failed element search.
### :returns: The resulting `Text` value.
@rv("ElementNotFoundError.crash_message")
routine ElementNotFoundError.crash_message() -> Text

### Returns the default message for adding to a collection that has no room left.
### :returns: The resulting `Text` value.
@rv("FullCollectionError.crash_message")
routine FullCollectionError.crash_message() -> Text
