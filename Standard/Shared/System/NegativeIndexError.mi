module System

# Each declaration below creates nothing: `@ra` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the crashable raised when a collection is given a negative position. Positions count from 0.
@ra("NegativeIndexError")
crashable NegativeIndexError
    ### Stores the position that was asked for.
    index: Int

### Returns the default message for a negative position.
### :returns: The resulting `Text` value.
@ra("NegativeIndexError.crash_message")
routine NegativeIndexError.crash_message() -> Text
