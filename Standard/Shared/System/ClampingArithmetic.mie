module System

# Each declaration below creates nothing: `@rv` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the shared saturating arithmetic surface for bounded numeric types.
### Types that obey `ClampingArithmetic` provide non-throwing arithmetic
### operators that clamp out-of-range results to the nearest representable bound
### instead of overflowing.
@rv("ClampingArithmetic")
protocol ClampingArithmetic
obeys ClampingAddable, ClampingSubtractable, ClampingMultiplicable, ClampingExponentiable
