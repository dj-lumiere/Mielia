module System

# Each declaration below creates nothing: `@ra` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the aggregate protocol for unsigned fixed-width integers.
### `UnsignedIntegral` covers bounded machine integer types whose domain contains
### only non-negative values.
@ra("UnsignedIntegral")
protocol UnsignedIntegral
obeys FixedIntegral
