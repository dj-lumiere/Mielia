module System/Serialization

# Each declaration below creates nothing: `@rv` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Encodes this `SerialValue` tree as JSON `Text`. Total — never fails.
### :returns: The JSON rendering.
@rv("SerialValue.to_json_text")
routine SerialValue.to_json_text() -> Text

### Encodes this `SerialValue` tree as UTF-8 JSON `Bytes`. Total — never fails.
### :returns: The UTF-8 encoded JSON.
@rv("SerialValue.to_json_bytes")
routine SerialValue.to_json_bytes() -> Bytes
