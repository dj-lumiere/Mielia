module System

# Each declaration below creates nothing: `@rv` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the crashable raised when a numeric operation exceeds the valid
### range or domain guarantees of the target type.
@rv("NumericOverflowError")
crashable NumericOverflowError
    ### Stores a preformatted description of the overflow condition.
    description: Text

### Returns the stored numeric overflow message.
### :returns: The resulting `Text` value.
@rv("NumericOverflowError.crash_message")
routine NumericOverflowError.crash_message() -> Text
