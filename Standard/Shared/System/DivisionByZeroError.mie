module System

# Each declaration below creates nothing: `@ra` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the crashable raised when a division operation receives a zero
### divisor.
@ra("DivisionByZeroError")
crashable DivisionByZeroError
    nothing

### Returns the default message for division-by-zero failures.
### :returns: The resulting `Text` value.
@ra("DivisionByZeroError.crash_message")
routine DivisionByZeroError.crash_message() -> Text
