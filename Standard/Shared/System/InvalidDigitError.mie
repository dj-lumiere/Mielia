module System

# Each declaration below creates nothing: `@rv` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Represents the crashable raised when a byte is not a valid ASCII decimal digit.
@rv("InvalidDigitError")
crashable InvalidDigitError
    nothing

### Returns the default message for invalid ASCII decimal digit failures.
### :returns: The resulting `Text` value.
@rv("InvalidDigitError.crash_message")
routine InvalidDigitError.crash_message() -> Text
