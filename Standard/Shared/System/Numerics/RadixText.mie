module System/Numerics

# Each declaration below creates nothing: `@rv` names the shared declaration it shows, and validate-stdlib
# checks that the two still match.

### Crashes unless `radix` is a base this module can render (2 to 36).
### :param radix: The requested numeric base.
### :throws: {NumericDomainError} if `radix` is below 2 or above 36.
@rv("check_radix")
routine check_radix(radix: S32)

### The digits of `mag` in base `radix`, with a leading `-` when `negative`.
### :param mag: The magnitude to render.
### :param negative: Whether to prefix a minus sign.
### :param radix: The numeric base (2 to 36).
### :returns: The rendered `Text`.
@rv("radix_text")
routine radix_text(mag: U64, negative: Bool, radix: S32) -> Text

### `radix_text` for a signed 64-bit value (the 8/16/32-bit signed types sign-extend into it first).
### Takes the magnitude through the raw bits so `S64` minimum renders correctly.
### :param value: The value to format.
### :param radix: The base, 2 to 36.
### :returns: The digits, with a leading `-` for a negative value.
@rv("signed_radix_text")
routine signed_radix_text(value: S64, radix: S32) -> Text

### `radix_text` for a `U128` magnitude.
### :param mag: The magnitude to format.
### :param negative: `true` to put a `-` in front.
### :param radix: The base, 2 to 36.
### :returns: The digits, with a leading `-` when `negative` is true.
@rv("wide_radix_text")
routine wide_radix_text(mag: U128, negative: Bool, radix: S32) -> Text

### `radix_text` for a `U256` magnitude.
### :param mag: The magnitude to format.
### :param negative: `true` to put a `-` in front.
### :param radix: The base, 2 to 36.
### :returns: The digits, with a leading `-` when `negative` is true.
@rv("wide_radix_text")
routine wide_radix_text(mag: U256, negative: Bool, radix: S32) -> Text
