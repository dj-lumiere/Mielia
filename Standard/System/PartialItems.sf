module System

import BuilderQuery

### A run of up to `COUNT` values laid out in place, whose count changes while the program runs.
###
### `PartialItems[T, COUNT]` is `Items[T, COUNT]` with a count: the room for `COUNT` elements is fixed at build
### time and lives inside the value itself, and the first `count()` of them hold an element. `add_last` fills the
### next place and `remove_last` gives the last element back. Adding to a full `PartialItems` is an ordinary
### failure (`FullCollectionError`), so `try` and `check` can receive it. Because it is a record, `=` copies it.
###
### **When to use**
### - The most elements that can ever be held is known at build time, and the count is only known while running
###   (a stack of known greatest depth, a small buffer, a path of bounded length).
### - Use {Items[T, COUNT]} when every place always holds an element.
### - Use {List[T]} when there is no greatest count.
###
### **Complexity**
### | Operation | Time |
### |---|---|
### | `add_last` / `remove_last` | O(1) |
### | `xs[i]` / `xs[i] = v` | O(1) |
### | `has` | O(count) |
### | Iteration | O(count) |
###
### :typeparam T: The element type stored in the places.
### :typeparam COUNT: The most elements held, a `U64` fixed at build time.
record PartialItems[T, COUNT]
relates PartialItemsEmitter[T, COUNT] as Emitter
obeys Emittable[T], Container
needs U64 COUNT
    ### The places, of which the first `used` hold an element.
    secret places: Items[T, COUNT]
    ### How many places hold an element.
    secret used: U64

### Walks the elements of a `PartialItems[T, COUNT]` that are held, from index 0 up. It reads a copy of the elements.
### :typeparam T: The element type yielded by the emitter.
### :typeparam COUNT: The most elements the walked value holds.
entity PartialItemsEmitter[T, COUNT]
obeys Emitter[T]
needs U64 COUNT
    ### The elements the walk reads.
    secret source: PartialItems[T, COUNT]
    ### The next position to read.
    secret index: U64

### Creates a `PartialItems` that holds no element yet.
routine PartialItems[T, COUNT]() -> PartialItems[T, COUNT]
    return PartialItems[T, COUNT](places: Items[T, COUNT](), used: 0)

### Returns how many places hold an element.
routine PartialItems[T, COUNT].count() -> Int
    return me.used.to[Int]()

### Returns the most elements this value holds, the buildtime parameter `COUNT`.
routine PartialItems[T, COUNT].capacity() -> Int
    var n: U64 = COUNT
    return n.to[Int]()

### Returns whether no place holds an element.
routine PartialItems[T, COUNT].is_empty() -> Bool
    return me.used == 0

### Returns whether every place holds an element, so `add_last` would fail.
routine PartialItems[T, COUNT].is_full() -> Bool
    return me.used >= COUNT

### Puts `value` in the next place, after the elements held.
### :param value: The value to add.
### :throws: {FullCollectionError} All `COUNT` places hold an element.
routine PartialItems[T, COUNT].add_last(value: T)
    if me.used >= COUNT
        throw FullCollectionError(capacity: COUNT)
    me.places.put_raw(index: me.used, value: value)
    me.used = me.used + 1
    return

### Adds the steps that run next, given in the order they run, so that `remove_last` gives them back in that order.
### `stack.add_next(a, b, c)` leaves `a` at the back, then `b`, then `c`. When they do not all fit, none is added.
### :param steps: The steps in the order they should come back out.
### :throws: {FullCollectionError} There is not room for every step.
routine PartialItems[T, COUNT].add_next(steps...: T)
    if steps.count() > COUNT - me.used
        throw FullCollectionError(capacity: COUNT)
    var i = steps.count()
    until i == 0
        i = i -% 1
        me.add_last(value: steps.get_raw(index: i))
    return

### Removes the last element and gives it back.
### :throws: {AbsentValueError} No place holds an element.
routine PartialItems[T, COUNT].remove_last() -> T
    if me.used == 0
        throw AbsentValueError()
    me.used = me.used - 1
    var value = me.places.at(position: me.used)
    me.places.erase_at(position: me.used)
    return value

### Removes every element. The places that held one are free for `add_last` again.
routine PartialItems[T, COUNT].clear()
    me.cut(kept: 0)
    return

### Returns the element at `index` (`xs[i]`).
### :param index: The position to read, from 0.
### :throws: {IndexOutOfBoundsError} `index` is at or past the count.
routine PartialItems[T, COUNT].getitem(index: Int) -> T
needs RecordType T
    return me.places.at(position: me.checked_position(index: index))

### Replaces the element at `index` (`xs[i] = v`).
### :param index: The position to write, from 0.
### :param value: The new element.
### :throws: {IndexOutOfBoundsError} `index` is at or past the count.
routine PartialItems[T, COUNT].setitem(index: Int, value: T)
    me.places.put(position: me.checked_position(index: index), value: value)
    return

### Returns the first element held.
### :throws: {AbsentValueError} No place holds an element.
routine PartialItems[T, COUNT].first() -> T
    if me.used == 0
        throw AbsentValueError()
    return me.places.at(position: 0)

### Returns the last element held, leaving it in place.
### :throws: {AbsentValueError} No place holds an element.
routine PartialItems[T, COUNT].last() -> T
    if me.used == 0
        throw AbsentValueError()
    return me.places.at(position: me.used - 1)

### Returns whether some element held equals `value` (`xs.has(v)`).
### :param value: The value to look for.
routine PartialItems[T, COUNT].has(value: T) -> Bool
needs T obeys Equatable
    var i: U64 = 0
    until i >= me.used
        if me.places.at(position: i) == value
            return true
        i = i + 1
    return false

### Returns whether `value` is not among the elements held: the opposite of `has`.
### :param value: The value to look for.
routine PartialItems[T, COUNT].lacks(value: T) -> Bool
needs T obeys Equatable
    return not me.has(value)

### Returns a walk over the elements held, front to back.
routine PartialItems[T, COUNT].emitter() -> PartialItemsEmitter[T, COUNT]
    return PartialItemsEmitter[T, COUNT](source: me, index: 0)

### Returns the next element held.
### :throws: {AbsentValueError} Every element held has been yielded.
routine PartialItemsEmitter[T, COUNT].emit() -> T
    if me.index >= me.source.used
        throw AbsentValueError()
    var value = me.source.places.at(position: me.index)
    me.index = me.index + 1
    return value

### Tears down the elements held. The places that hold none are not touched.
@override
routine PartialItems[T, COUNT].destruct()
    me.cut(kept: 0)
    return

### Returns a copy with each element held shared.
@override
secret infallible routine PartialItems[T, COUNT].share() -> PartialItems[T, COUNT]
    var result = PartialItems[T, COUNT]()
    var i: U64 = 0
    until i >= me.used
        result.add_last(value: me.places.at(position: i))
        i = i + 1
    return result

### Returns the elements as text: `[1, 2, 3]`.
@override
routine PartialItems[T, COUNT].represent() -> Text
    return me.elements_text(diagnosing: false)

### Returns the type, then the elements held in their diagnostic form.
@override
routine PartialItems[T, COUNT].diagnose() -> Text
    return f"{me.full_type_name()}({me.elements_text(diagnosing: true)})"

### The position `index` names, crashing unless it is the position of an element held.
secret routine PartialItems[T, COUNT].checked_position(index: Int) -> U64
    var at = position_of(value: index)
    if at >= me.used
        throw IndexOutOfBoundsError(index: at, count: me.used)
    return at

### Tears down the elements from position `kept` on, keeping the first `kept` (at most the count held).
secret routine PartialItems[T, COUNT].cut(kept: U64)
    var i = kept
    until i >= me.used
        me.places.erase_at(position: i)
        i = i + 1
    me.used = kept
    return

### The elements as text: `[1, 2, 3]`.
### :param diagnosing: Whether this is for `diagnose()`, where a text element is quoted with its escapes.
secret routine PartialItems[T, COUNT].elements_text(diagnosing: Bool) -> Text
    var result = "["
    var i: U64 = 0
    until i >= me.used
        if i > 0
            result = f"{result}, "
        result = f"{result}{nested_form(value: me.places.at(position: i), diagnosing: diagnosing)}"
        i = i + 1
    return f"{result}]"
