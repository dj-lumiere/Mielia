module System/Numerics

# Suflae's surface of the numbers it shares with RazorForge: the same values, with `Int` in place of the
# fixed-width integers that give a precision, a number of places, an exponent or a radix. A Suflae program
# calls these in place of the RazorForge routines called the same way.

### Returns `me` raised to the integer power `n` via exponentiation by squaring.
### A negative `n` inverts the result. A non-finite intermediate crashes, as for all `Decimal`
### arithmetic.
### :param n: The integer exponent.
### :returns: `me ** n`.
routine Decimal.powi(n: Int) -> Decimal
    return me.powi(n: n.to[S64]().to[S32]())

### Renders this value with exactly `places` digits after the point, rounded from its exact value by `rule`, half up
### when left out (`2.675.fixed(2)` is `2.68`, `-7.125.fixed(2)` is `-7.12`, `-2.5.fixed(0)` is `-2`). The integer
### part is always written out in full, never in exponent form.
### :param places: The number of digits after the point (0 for none).
### :param rule: How the digits past them go.
### :returns: The rendered `Text`.
routine Decimal.fixed(places: Int, rule: RoundingRule = RoundingRule.HALF_UP) -> Text
    return me.fixed(places: places.to[U64](), rule: rule)

### Rounds to `places` digits after the point by `rule`, half up when left out: `x.round()` is the whole number n
### with n - 0.5 <= x < n + 0.5 (2.5 -> 3, -2.5 -> -2, -0.5 -> 0), `2.675.round(places: 2)` is 2.68,
### `(-2.5).round(rule: RoundingRule.HALF_EVEN)` is -2.
### :param places: The digits after the point kept (0 for a whole number).
### :param rule: How the digits past them go.
### :returns: The rounded value.
routine Decimal.round(places: Int = 0, rule: RoundingRule = RoundingRule.HALF_UP) -> Decimal
    return me.round(places: places.to[U64](), rule: rule)

### Returns `me + you` computed exactly, then rounded once to `places` digits after the point by `rule` (half up when
### left out): where the operator fails past 34 digits, this rounds.
### :param you: The number added.
### :param places: The digits after the point kept.
### :param rule: How the digits past them go.
### :returns: The rounded sum.
### :throws: {NumericOverflowError} when even the rounded result needs more than 34 significant digits.
routine Decimal.add_round(you: Decimal, places: Int, rule: RoundingRule = RoundingRule.HALF_UP) -> Decimal
    return me.add_round(you: you, places: places.to[U64](), rule: rule)

### Returns `me - you` computed exactly, then rounded once to `places` digits after the point by `rule` (half up when
### left out): where the operator fails past 34 digits, this rounds.
### :param you: The number taken away.
### :param places: The digits after the point kept.
### :param rule: How the digits past them go.
### :returns: The rounded difference.
### :throws: {NumericOverflowError} when even the rounded result needs more than 34 significant digits.
routine Decimal.sub_round(you: Decimal, places: Int, rule: RoundingRule = RoundingRule.HALF_UP) -> Decimal
    return me.sub_round(you: you, places: places.to[U64](), rule: rule)

### Returns `me * you` computed exactly, then rounded once to `places` digits after the point by `rule` (half up when
### left out): where the operator fails past 34 digits, this rounds.
### :param you: The other factor.
### :param places: The digits after the point kept.
### :param rule: How the digits past them go.
### :returns: The rounded product.
### :throws: {NumericOverflowError} when even the rounded result needs more than 34 significant digits.
routine Decimal.mul_round(you: Decimal, places: Int, rule: RoundingRule = RoundingRule.HALF_UP) -> Decimal
    return me.mul_round(you: you, places: places.to[U64](), rule: rule)

### Returns `me / you` rounded once to `places` digits after the point by `rule`, half up when left out
### (`1.div_round(3, places: 2)` is `0.33`).
### :param you: The divisor.
### :param places: The digits after the point kept.
### :param rule: How the digits past them go.
### :returns: The rounded quotient.
### :throws: {DivisionByZeroError} when `you` is zero; {NumericOverflowError} when the quotient at that place needs more
###     than 34 significant digits.
routine Decimal.div_round(you: Decimal, places: Int, rule: RoundingRule = RoundingRule.HALF_UP) -> Decimal
    return me.div_round(you: you, places: places.to[U64](), rule: rule)

### me * 10^n (the decimal analog of ldexp).
### :param n: The power-of-ten exponent to apply.
### :returns: `me * 10^n`.
routine Decimal.scaleb(n: Int) -> Decimal
    return me.scaleb(n: n.to[S64]())
