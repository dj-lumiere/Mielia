module Collections

import BuilderQuery

# The B-tree under Suflae's SortedList, SortedSet and SortedDict. A node is an entity holding its entries and its
# branches in fixed arrays, so one node is one allocation. A place no entry or branch uses is zero (empty), and an
# entry or branch moves between nodes by being written into an empty place of one and erased from the other.

### The most entries one node holds.
secret preset SORTED_MOST: U64 = 63
### The fewest entries a node other than the root holds.
secret preset SORTED_LEAST: U64 = 31

### One node of a {SortedTree[K, V]}: up to 63 entries in key order and, unless it is a leaf, one more branch than
### entries. Every key under branch `i` sorts no later than entry `i`, and every key under branch `i + 1` no earlier.
### :typeparam K: The key type.
### :typeparam V: The value type.
secret entity SortedNode[K, V]
needs K obeys Comparable
    ### The keys of the entries, in order.
    keys: Items[K, 63]
    ### The values of the entries.
    values: Items[V, 63]
    ### The nodes under this one.
    branches: Items[SortedNode[K, V], 64]
    ### How many entries the node holds.
    count: U64
    ### How many branches the node has.
    fan: U64
    ### How many entries the node and every node under it hold.
    size: U64
    ### Whether the node has no branches.
    leaf: Bool

### A B-tree of entries kept in key order, each entry a key and a value. Equal keys may sit side by side: the tree
### keeps them in the order they were added. Every node knows how many entries are under it, so the entry at a
### rank is found in O(log n).
### :typeparam K: The key type.
### :typeparam V: The value type.
secret entity SortedTree[K, V]
needs K obeys Comparable
    ### The top node, a leaf with no entries when the tree is empty.
    root: SortedNode[K, V]
    ### Stands for the tree where another task is concerned: it escapes together with the tree and is never replaced.
    gate: SortedGate

### What an entity stored into a tree asks whether the tree has escaped to another task: the nodes come and go, so
### none of them can say it.
secret entity SortedGate
    ### Nothing is kept here, an entity needs a member variable.
    unused: U64

# ============================================================================
# Creators
# ============================================================================

### Creates a node with no entries.
### :param leaf: Whether the node has no branches.
routine SortedNode[K, V](leaf: Bool) -> SortedNode[K, V]
    return SortedNode[K, V](
        keys: Items[K, 63](),
        values: Items[V, 63](),
        branches: Items[SortedNode[K, V], 64](),
        count: 0,
        fan: 0,
        size: 0,
        leaf: leaf,
    )

### Creates an empty tree.
routine SortedTree[K, V]() -> SortedTree[K, V]
    return SortedTree[K, V](root: SortedNode[K, V](leaf: true), gate: SortedGate(unused: 0))

# ============================================================================
# Inside a node
# ============================================================================

### The first entry whose key does not sort before `key`.
### :param key: The key to look for.
### :returns: The position of that entry, or the count when there is none.
secret routine SortedNode[K, V].lower(key: K) -> U64
    var low: U64 = 0
    var high = me.count
    until low >= high
        var middle = (low + high) // 2
        if me.keys.get_raw(index: middle) < key
            low = middle + 1
        else
            high = middle
    return low

### The first entry whose key sorts after `key`.
### :param key: The key to look for.
### :returns: The position of that entry, or the count when there is none.
secret routine SortedNode[K, V].upper(key: K) -> U64
    var low: U64 = 0
    var high = me.count
    until low >= high
        var middle = (low + high) // 2
        if key < me.keys.get_raw(index: middle)
            high = middle
        else
            low = middle + 1
    return low

### Whether entry `at` exists and has the key `key`.
### :param at: The position of the entry.
### :param key: The key to compare.
### :returns: true when the entry exists with that key.
secret routine SortedNode[K, V].holds(at: U64, key: K) -> Bool
    return at < me.count and me.keys.get_raw(index: at) == key

### How many entries branch `at` holds itself.
### :param at: The position of the branch.
### :returns: The entry count.
secret routine SortedNode[K, V].branch_count(at: U64) -> U64
    return me.branches[at].count

### How many entries are under branch `at`.
### :param at: The position of the branch.
### :returns: The entry count.
secret routine SortedNode[K, V].branch_size(at: U64) -> U64
    return me.branches[at].size

### Opens a gap at entry `at` and puts `key` and `value` in it.
### :param at: The position of the new entry.
### :param key: The key to store.
### :param value: The value to store.
secret routine SortedNode[K, V].insert_entry(at: U64, key: K, value: V)
    if at < me.count
        me.keys.carry(source: at, target: at + 1, count: me.count - at)
        me.values.carry(source: at, target: at + 1, count: me.count - at)
    me.keys[at] = key
    me.values[at] = value
    me.count = me.count + 1
    return

### Replaces entry `at` with `key` and `value`.
### :param at: The position of the entry.
### :param key: The new key.
### :param value: The new value.
secret routine SortedNode[K, V].replace_entry(at: U64, key: K, value: V)
    me.keys.erase_at(position: at)
    me.values.erase_at(position: at)
    me.keys[at] = key
    me.values[at] = value
    return

### Removes entry `at` and closes the gap.
### :param at: The position of the entry.
secret routine SortedNode[K, V].remove_entry(at: U64)
    me.keys.erase_at(position: at)
    me.values.erase_at(position: at)
    if at + 1 < me.count
        me.keys.carry(source: at + 1, target: at, count: me.count - at - 1)
        me.values.carry(source: at + 1, target: at, count: me.count - at - 1)
    me.count = me.count - 1
    return

### Opens a gap at branch `at` and puts `branch` in it.
### :param at: The position of the new branch.
### :param branch: The branch to insert.
secret routine SortedNode[K, V].insert_branch(at: U64, branch: SortedNode[K, V])
    if at < me.fan
        me.branches.carry(source: at, target: at + 1, count: me.fan - at)
    me.branches[at] = branch
    me.fan = me.fan + 1
    return

### Removes branch `at` and closes the gap.
### :param at: The position of the branch.
secret routine SortedNode[K, V].remove_branch(at: U64)
    me.branches.erase_at(position: at)
    if at + 1 < me.fan
        me.branches.carry(source: at + 1, target: at, count: me.fan - at - 1)
    me.fan = me.fan - 1
    return

### Moves the entries of `source` from entry `first` on to the end of this node.
### :param source: The node to take the entries from.
### :param first: The position of the first entry to take.
secret routine SortedNode[K, V].take_entries(source: SortedNode[K, V], first: U64)
    var i = first
    until i >= source.count
        me.keys[me.count] = source.keys[i]
        me.values[me.count] = source.values[i]
        source.keys.erase_at(position: i)
        source.values.erase_at(position: i)
        me.count = me.count + 1
        i = i + 1
    source.count = first
    return

### Moves the branches of `source` from branch `first` on to the end of this node.
### :param source: The node to take the branches from.
### :param first: The position of the first branch to take.
secret routine SortedNode[K, V].take_branches(source: SortedNode[K, V], first: U64)
    var i = first
    until i >= source.fan
        me.branches[me.fan] = source.branches[i]
        source.branches.erase_at(position: i)
        me.fan = me.fan + 1
        i = i + 1
    source.fan = first
    return

### Counts again how many entries are under this node, from its own entries and its branches' sizes.
secret routine SortedNode[K, V].recount()
    var total = me.count
    var i: U64 = 0
    until i >= me.fan
        total = total + me.branch_size(at: i)
        i = i + 1
    me.size = total
    return

# ============================================================================
# Size
# ============================================================================

### How many entries the tree holds.
secret routine SortedTree[K, V].count() -> U64
    return me.root.size

### Removes every entry.
secret routine SortedTree[K, V].clear()
    me.root = SortedNode[K, V](leaf: true)
    return

# ============================================================================
# Finding
# ============================================================================

### Whether an entry with the key `key` is in the tree.
### :param key: The key to look for.
### :returns: `true` if `key` is stored.
secret routine SortedTree[K, V].has_key(key: K) -> Bool
    return me.has_in(node: me.root, key: key)

### Whether the key is in the tree under a node.
### :param node: The node to search under.
### :param key: The key to look for.
### :returns: true when the key is found.
secret routine SortedTree[K, V].has_in(node: SortedNode[K, V], key: K) -> Bool
    var i = node.lower(key: key)
    if node.holds(at: i, key: key)
        return true
    if node.leaf
        return false
    return me.has_in(node: node.branches[i], key: key)

### How many entries have a key that sorts before `key`, or with `after`, how many do not sort after it.
### :param key: The key to place.
### :param after: Whether entries with the key `key` count too.
secret routine SortedTree[K, V].rank(key: K, after: Bool) -> U64
    return me.rank_in(node: me.root, key: key, after: after)

### How many entries sort before the key (or up to it) under a node.
### :param node: The node to count under.
### :param key: The key to look for.
### :param after: true to count entries equal to the key too.
### :returns: The number of such entries.
secret routine SortedTree[K, V].rank_in(node: SortedNode[K, V], key: K, after: Bool) -> U64
    var i = if after then node.upper(key: key) else node.lower(key: key)
    if node.leaf
        return i
    var total = i
    var b: U64 = 0
    until b >= i
        total = total + node.branch_size(at: b)
        b = b + 1
    return total + me.rank_in(node: node.branches[i], key: key, after: after)

### The key of the entry at `rank` (counted from 0 in key order). The rank must be below `count()`.
### :param rank: The position of the entry in key order, counted from 0.
### :returns: The key.
secret routine SortedTree[K, V].key_at(rank: U64) -> K
    return me.key_at_in(node: me.root, rank: rank)

### The key of the entry at a rank under a node.
### :param node: The node to look under.
### :param rank: The position of the entry in key order under the node, counted from 0.
### :returns: The key.
secret routine SortedTree[K, V].key_at_in(node: SortedNode[K, V], rank: U64) -> K
    if node.leaf
        return node.keys[rank]
    var left = rank
    var i: U64 = 0
    until i >= node.count
        var below = node.branch_size(at: i)
        if left < below
            return me.key_at_in(node: node.branches[i], rank: left)
        left = left - below
        if left == 0
            return node.keys[i]
        left = left - 1
        i = i + 1
    return me.key_at_in(node: node.branches[node.count], rank: left)

### The value of the entry at `rank` (counted from 0 in key order). The rank must be below `count()`.
### :param rank: The position of the entry in key order, counted from 0.
### :returns: The value.
secret routine SortedTree[K, V].value_at(rank: U64) -> V
    return me.value_at_in(node: me.root, rank: rank)

### The value of the entry at a rank under a node.
### :param node: The node to look under.
### :param rank: The position of the entry in key order under the node, counted from 0.
### :returns: The value.
secret routine SortedTree[K, V].value_at_in(node: SortedNode[K, V], rank: U64) -> V
    if node.leaf
        return node.values[rank]
    var left = rank
    var i: U64 = 0
    until i >= node.count
        var below = node.branch_size(at: i)
        if left < below
            return me.value_at_in(node: node.branches[i], rank: left)
        left = left - below
        if left == 0
            return node.values[i]
        left = left - 1
        i = i + 1
    return me.value_at_in(node: node.branches[node.count], rank: left)

### The value of the first entry with the key `key`, which must be in the tree.
### :param key: The key to look for.
### :returns: The value.
secret routine SortedTree[K, V].value_of(key: K) -> V
    return me.value_of_in(node: me.root, key: key)

### The value of the first entry with a key under a node.
### :param node: The node to look under.
### :param key: The key to look for, which must be there.
### :returns: The value.
secret routine SortedTree[K, V].value_of_in(node: SortedNode[K, V], key: K) -> V
    var i = node.lower(key: key)
    if node.holds(at: i, key: key)
        return node.values[i]
    return me.value_of_in(node: node.branches[i], key: key)

### Gives the first entry with the key `key`, which must be in the tree, the value `value`.
### :param key: The key to look for.
### :param value: The value to use.
secret routine SortedTree[K, V].replace(key: K, value: V)
    admit_entry(gate: me.gate, key: key, value: value)
    me.replace_in(node: me.root, key: key, value: value)
    return

### Replaces the value of the first entry with a key under a node.
### :param node: The node to look under.
### :param key: The key to look for.
### :param value: The new value.
secret routine SortedTree[K, V].replace_in(node: SortedNode[K, V], key: K, value: V)
    var i = node.lower(key: key)
    if node.holds(at: i, key: key)
        node.values.erase_at(position: i)
        node.values[i] = value
        return
    me.replace_in(node: node.branches[i], key: key, value: value)
    return

# ============================================================================
# Adding
# ============================================================================

### Adds an entry, after every entry with the same key.
### :param key: The key to look for.
### :param value: The value to use.
secret routine SortedTree[K, V].insert(key: K, value: V)
    admit_entry(gate: me.gate, key: key, value: value)
    if me.root.count == SORTED_MOST
        var grown = SortedNode[K, V](leaf: false)
        grown.insert_branch(at: 0, branch: me.root)
        me.root = grown
        me.split(parent: me.root, at: 0)
        me.root.recount()
    me.insert_in(node: me.root, key: key, value: value)
    return

### Adds an entry under `node`, which is not full.
### :param node: The node to add under.
### :param key: The key to add.
### :param value: The value to add.
secret routine SortedTree[K, V].insert_in(node: SortedNode[K, V], key: K, value: V)
    var i = node.upper(key: key)
    node.size = node.size + 1
    if node.leaf
        node.insert_entry(at: i, key: key, value: value)
        return
    if node.branch_count(at: i) == SORTED_MOST
        me.split(parent: node, at: i)
        if node.keys.get_raw(index: i) <= key
            i = i + 1
    me.insert_in(node: node.branches[i], key: key, value: value)
    return

### Splits the full branch `at` of `parent` in two around its middle entry, which moves up into `parent`.
### :param parent: The node holding the full branch.
### :param at: The position of the full branch.
secret routine SortedTree[K, V].split(parent: SortedNode[K, V], at: U64)
    var child = parent.branches[at]
    var right = SortedNode[K, V](leaf: child.leaf)
    right.take_entries(source: child, first: 32)
    if not child.leaf
        right.take_branches(source: child, first: 32)
    parent.insert_entry(at: at, key: child.keys[31], value: child.values[31])
    child.remove_entry(at: 31)
    child.recount()
    right.recount()
    parent.insert_branch(at: at + 1, branch: right)
    return

# ============================================================================
# Removing
# ============================================================================

### Removes the first entry with the key `key`.
### :param key: The key to look for.
### :returns: `true` when there was one.
secret routine SortedTree[K, V].remove(key: K) -> Bool
    var removed = me.remove_in(node: me.root, key: key)
    if me.root.count == 0 and not me.root.leaf
        me.root = me.root.branches[0]
    return removed

### Removes an entry with the key `key` from under `node`, which holds more than the fewest entries (or is the
### root).
### :param node: The node to remove from.
### :param key: The key to remove.
### :returns: true when an entry was removed.
secret routine SortedTree[K, V].remove_in(node: SortedNode[K, V], key: K) -> Bool
    var i = node.lower(key: key)
    var here = node.holds(at: i, key: key)
    if node.leaf
        if not here
            return false
        node.remove_entry(at: i)
        node.size = node.size - 1
        return true
    if here
        if node.branch_count(at: i) > SORTED_LEAST
            me.pull_last(node: node.branches[i], into: node, at: i)
            node.size = node.size - 1
            return true
        if node.branch_count(at: i + 1) > SORTED_LEAST
            me.pull_first(node: node.branches[i + 1], into: node, at: i)
            node.size = node.size - 1
            return true
        me.merge(node: node, at: i)
    else
        i = me.fix(node: node, at: i)
    var removed = me.remove_in(node: node.branches[i], key: key)
    if removed
        node.size = node.size - 1
    return removed

### Takes the last entry from under `node`, which holds more than the fewest entries, and puts it in place of
### entry `at` of `into`.
### :param node: The node to take the entry from.
### :param into: The node that receives the entry.
### :param at: The position of the entry in `into` to replace.
secret routine SortedTree[K, V].pull_last(node: SortedNode[K, V], into: SortedNode[K, V], at: U64)
    node.size = node.size - 1
    if node.leaf
        var last = node.count - 1
        into.replace_entry(at: at, key: node.keys[last], value: node.values[last])
        node.remove_entry(at: last)
        return
    var b = me.fix(node: node, at: node.fan - 1)
    me.pull_last(node: node.branches[b], into: into, at: at)
    return

### Takes the first entry from under `node`, which holds more than the fewest entries, and puts it in place of
### entry `at` of `into`.
### :param node: The node to take the entry from.
### :param into: The node that receives the entry.
### :param at: The position of the entry in `into` to replace.
secret routine SortedTree[K, V].pull_first(node: SortedNode[K, V], into: SortedNode[K, V], at: U64)
    node.size = node.size - 1
    if node.leaf
        into.replace_entry(at: at, key: node.keys[0], value: node.values[0])
        node.remove_entry(at: 0)
        return
    var b = me.fix(node: node, at: 0)
    me.pull_first(node: node.branches[b], into: into, at: at)
    return

### Makes sure branch `at` of `node` holds more than the fewest entries, by moving one entry over from a branch
### next to it or by merging it with one.
### :param node: The node holding the branch.
### :param at: The position of the branch.
### :returns: Where that branch is now.
secret routine SortedTree[K, V].fix(node: SortedNode[K, V], at: U64) -> U64
    if node.branch_count(at: at) > SORTED_LEAST
        return at
    if at > 0 and node.branch_count(at: at - 1) > SORTED_LEAST
        me.shift_right(node: node, at: at)
        return at
    if at + 1 < node.fan and node.branch_count(at: at + 1) > SORTED_LEAST
        me.shift_left(node: node, at: at)
        return at
    if at > 0
        me.merge(node: node, at: at - 1)
        return at - 1
    me.merge(node: node, at: at)
    return at

### Moves the last entry of branch `at - 1` up into `node` and the entry between them down into branch `at`.
### :param node: The node holding the branches.
### :param at: The position of the branch that gains an entry.
secret routine SortedTree[K, V].shift_right(node: SortedNode[K, V], at: U64)
    var left = node.branches[at - 1]
    var child = node.branches[at]
    child.insert_entry(at: 0, key: node.keys[at - 1], value: node.values[at - 1])
    var last = left.count - 1
    node.replace_entry(at: at - 1, key: left.keys[last], value: left.values[last])
    left.remove_entry(at: last)
    if not child.leaf
        child.insert_branch(at: 0, branch: left.branches[left.fan - 1])
        left.remove_branch(at: left.fan - 1)
    left.recount()
    child.recount()
    return

### Moves the first entry of branch `at + 1` up into `node` and the entry between them down into branch `at`.
### :param node: The node holding the branches.
### :param at: The position of the branch that gains an entry.
secret routine SortedTree[K, V].shift_left(node: SortedNode[K, V], at: U64)
    var right = node.branches[at + 1]
    var child = node.branches[at]
    child.insert_entry(at: child.count, key: node.keys[at], value: node.values[at])
    node.replace_entry(at: at, key: right.keys[0], value: right.values[0])
    right.remove_entry(at: 0)
    if not child.leaf
        child.insert_branch(at: child.fan, branch: right.branches[0])
        right.remove_branch(at: 0)
    right.recount()
    child.recount()
    return

### Merges branch `at + 1` of `node` into branch `at`, with entry `at` of `node` moving down between them.
### :param node: The node holding the branches.
### :param at: The position of the left branch.
secret routine SortedTree[K, V].merge(node: SortedNode[K, V], at: U64)
    var left = node.branches[at]
    var right = node.branches[at + 1]
    left.insert_entry(at: left.count, key: node.keys[at], value: node.values[at])
    left.take_entries(source: right, first: 0)
    if not left.leaf
        left.take_branches(source: right, first: 0)
    left.size = left.size + right.size + 1
    node.remove_entry(at: at)
    node.remove_branch(at: at + 1)
    return

# ============================================================================
# Entities stored into a tree
# ============================================================================

### Called before an entry goes into a tree whose gate is `gate`. When the tree has escaped to another task, the
### entities the key and the value hold a handle to escape first (with everything they reach), since the store makes
### them reachable from that task. A key or value of a type that holds no handle costs nothing.
### :param gate: The gate of the tree.
### :param key: The key about to be stored.
### :param value: The value about to be stored.
@inline
secret routine admit_entry[K, V](gate: SortedGate, key: K, value: V)
    if K.shares_entity_across_tasks() or V.shares_entity_across_tasks()
        danger
            if C::ingrid_roam_store_begin(holder: LLVM::reinterpret_bits[SortedGate, Addr](value: gate))
                if K.shares_entity_across_tasks()
                    key.roam_trace()
                if V.shares_entity_across_tasks()
                    value.roam_trace()
                C::ingrid_roam_store_end()
    return
