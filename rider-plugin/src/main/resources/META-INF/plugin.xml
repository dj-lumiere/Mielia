<idea-plugin>
    <id>com.mielia.rider</id>
    <name>Mielia</name>
    <vendor email="djminstar573@gmail.com">mielia</vendor>

    <description><![CDATA[
        Mielia (<code>.mie</code>) in Rider: syntax highlighting, comment and bracket handling, and the Mielia
        language server (<code>Mielia lsp</code>) for diagnostics, completion, hover, navigation, rename, inlay hints
        and formatting.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>org.jetbrains.plugins.textmate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <editorFactoryListener implementation="com.mielia.rider.MieliaEditorListener"/>
        <textmate.bundleProvider implementation="com.mielia.rider.MieliaBundleProvider"/>
        <lang.syntaxHighlighterFactory language="mielia" implementationClass="com.mielia.rider.MieliaSyntaxHighlighterFactory"/>
        <fileIconProvider implementation="com.mielia.rider.MieliaIconProvider"/>
        <platform.lsp.integrationProvider implementation="com.mielia.rider.MieliaLanguageServer"/>
        <actionConfigurationCustomizer order="last" implementation="com.mielia.rider.MieliaCleanupActions"/>
        <colorSettingsPage implementation="com.mielia.rider.MieliaColorSettingsPage"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/MieliaDarcula.xml"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/MieliaDefault.xml"/>
        <applicationConfigurable
            parentId="language"
            id="com.mielia.rider.settings"
            displayName="Mielia"
            instance="com.mielia.rider.MieliaConfigurable"/>
    </extensions>

    <projectListeners>
        <listener
            class="com.mielia.rider.MieliaFileOpenListener"
            topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
